# QQueueing 로컬 실행 설정 예시
# 값을 바꾸려면 이 파일을 .env로 복사해서 고친다: cp .env.example .env
# .env가 없으면 compose 파일에 적힌 기본값(이 파일과 같은 값)을 쓴다. .env는 커밋하지 않는다.

# 호스트에 여는 포트
MAIN_PORT=8081
CONSUMER_PORT=8082
# 관리자 화면(qqueueing-frontend)
ADMIN_PORT=3001
GRAFANA_PORT=3002
PROMETHEUS_PORT=3003
NODE_EXPORTER_PORT=8100
MONGO_PORT=27017
# 대기열 상태를 두는 Redis. IDE에서 main을 직접 실행할 때는 localhost:<이 포트>로 붙는다.
REDIS_PORT=6379
# 호스트용 Kafka listener 포트. IDE에서 main·consumer를 직접 실행할 때는 localhost:<이 포트>로 붙는다.
# 컨테이너끼리는 qqueueing-kafka:9092를 쓴다.
KAFKA_HOST_PORT=9094

# Mongo 루트 계정. Mongo 데이터가 처음 만들어질 때만 적용된다.
# compose가 이 값으로 컨테이너 main의 Mongo 접속 URI(SPRING_DATA_MONGODB_URI)를 만든다. URI에 그대로 들어가므로 @ : / ? # % 는 쓰지 않는다.
# IDE에서 main을 직접 실행하면 application.yml 기본값(root/example)으로 붙는다. 값을 바꿨다면 SPRING_DATA_MONGODB_URI 환경변수를 따로 넘긴다.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example

# 브라우저가 접속하는 공개 origin(데모 nginx). 끝에 /를 붙이지 않는다.
# main의 대기 페이지 리다이렉트 주소와 관리자 화면의 API 주소(<PUBLIC_ORIGIN>/qqueueingAPI)가 이 값을 기준으로 한다.
# 관리자 화면에는 빌드할 때 값이 박히므로, 바꾼 뒤에는 docker compose up -d --build로 다시 빌드한다.
PUBLIC_ORIGIN=https://localhost

# URL 등록 에이전트(qqueueing-agent)가 설정을 고치고 reload할 nginx 컨테이너 이름. 기본값은 데모 nginx(demo/compose.yml의 container_name)다.
TARGET_NGINX_CONTAINER=demo-nginx

# 데모 대상 사이트(demo/)
# 데모 MySQL 계정. MySQL 데이터(qqueueing_demo_mysql_data 볼륨)가 처음 만들어질 때만 적용된다.
# 바꾼 뒤에는 docker compose down 후 docker volume rm qqueueing_demo_mysql_data로 데이터를 지우고 다시 올린다.
DEMO_MYSQL_USER=demo
DEMO_MYSQL_PASSWORD=demo
DEMO_MYSQL_ROOT_PASSWORD=root
# 데모 백엔드의 JWT 서명 키. Base64 문자열이고, 디코딩했을 때 32바이트 이상이어야 한다.
DEMO_JWT_KEY=ycWlgZR3xgLD5qsSg5ecwrmVH7RQcAGxzmgrA6kOgvbLXrFilhurm7qTrygVrtpa

# Grafana 관리자 계정. Grafana 데이터는 볼륨에 두지 않으므로 컨테이너를 새로 만들 때마다 이 값이 적용된다.
# 기본값(admin/admin)으로 로그인하면 비밀번호 변경 화면이 뜰 수 있는데, Skip으로 넘어가면 된다.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
