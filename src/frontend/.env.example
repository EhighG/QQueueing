# 관리자 프론트를 npm run dev로 직접 실행할 때 쓰는 설정 예시
# 복사해서 고친다: cp .env.example .env.local (.env와 .env*.local은 커밋하지 않는다)
# 컨테이너 이미지는 이 파일을 쓰지 않는다. compose가 루트 .env의 PUBLIC_ORIGIN으로 빌드 인자를 만든다(src/compose.yml).
# NEXT_PUBLIC_* 값은 번들에 박히므로 next build로 만든 결과물에는 빌드할 때의 값이 들어간다.

# main API 주소. 데모 nginx를 거치면 <PUBLIC_ORIGIN>/qqueueingAPI, main에 바로 붙으려면 http://localhost:8081
NEXT_PUBLIC_BASE_URL=https://localhost/qqueueingAPI
# 관리자 대시보드가 쓰는 모니터링 API 주소. 보통 NEXT_PUBLIC_BASE_URL과 같다.
NEXT_PUBLIC_MONITORING_URL=https://localhost/qqueueingAPI
# 대기열 등록 화면의 대상 URL 입력칸 기본값. 비워 둬도 된다.
NEXT_PUBLIC_TARGET_URL=
